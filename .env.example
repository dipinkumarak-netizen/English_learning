APP_ENV=development
APP_VERSION=0.1.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://nilaspeak:change-me-local@db:5432/nilaspeak
POSTGRES_DB=nilaspeak
POSTGRES_USER=nilaspeak
POSTGRES_PASSWORD=change-me-local
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
ALLOW_REGISTRATION=true
JWT_SECRET=replace-with-a-long-random-local-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AI_PROVIDER=none
AI_MODEL=mock-tutor-v1
AI_API_KEY=replace-with-provider-key
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=400
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_TOKEN_LIMIT=12000
AI_MAX_MESSAGE_CHARACTERS=2000
AI_CONVERSATION_CONTEXT_LIMIT=12
AI_PROVIDER_ENABLED=false
STT_PROVIDER=none
STT_MODEL=mock-stt-v1
STT_API_KEY=replace-with-stt-provider-key
STT_BASE_URL=
STT_REQUEST_TIMEOUT_SECONDS=20
STT_MAX_AUDIO_SECONDS=60
STT_MAX_UPLOAD_BYTES=5000000
STT_ENABLED=false
TTS_PROVIDER=none
TTS_MODEL=mock-tts-v1
TTS_VOICE=default
TTS_API_KEY=replace-with-tts-provider-key
TTS_BASE_URL=
TTS_REQUEST_TIMEOUT_SECONDS=20
TTS_MAX_TEXT_CHARACTERS=500
TTS_ENABLED=false
VOICE_DAILY_TRANSCRIPTION_SECONDS=600
VOICE_DAILY_SYNTHESIS_CHARACTERS=10000
VOICE_MAX_TURNS_PER_SESSION=20
VOICE_TEMP_AUDIO_RETENTION_MINUTES=30
VOICE_AUDIO_STORAGE_PATH=./runtime/audio
