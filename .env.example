APP_ENV=development
APP_VERSION=0.1.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://nilaspeak:<url-encoded-password>@db:5432/nilaspeak
DATABASE_EXPECTED_HOST=db
POSTGRES_DB=nilaspeak
POSTGRES_USER=nilaspeak
POSTGRES_PASSWORD=<generate-a-random-password>
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
ALLOW_REGISTRATION=true
JWT_SECRET=<generate-a-random-secret-at-least-32-bytes>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AI_PROVIDER=mock
AI_MODEL=mock-tutor-v1
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=400
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_TOKEN_LIMIT=12000
AI_MAX_MESSAGE_CHARACTERS=2000
AI_CONVERSATION_CONTEXT_LIMIT=12
AI_PROVIDER_ENABLED=true
STT_PROVIDER=none
STT_MODEL=mock-stt-v1
STT_API_KEY=
STT_BASE_URL=
STT_REQUEST_TIMEOUT_SECONDS=20
STT_MAX_AUDIO_SECONDS=60
STT_MAX_UPLOAD_BYTES=5000000
STT_ENABLED=false
TTS_PROVIDER=mock
TTS_MODEL=mock-tts-v1
TTS_VOICE=default
TTS_API_KEY=
TTS_BASE_URL=
TTS_REQUEST_TIMEOUT_SECONDS=20
TTS_MAX_TEXT_CHARACTERS=500
TTS_ENABLED=false
CREDENTIAL_ENCRYPTION_KEY=<url-safe-base64-32-byte-key>
CREDENTIAL_ENCRYPTION_PREVIOUS_KEY=
PROVIDER_ALLOWED_BASE_URLS=https://api.openai.com/v1
PROVIDER_ALLOW_LOCAL_URLS=false
PROVIDER_SETTINGS_RATE_LIMIT_PER_HOUR=10
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_NETWORKS=
PUBLIC_BASE_URL=
VOICE_DAILY_TRANSCRIPTION_SECONDS=600
VOICE_DAILY_SYNTHESIS_CHARACTERS=10000
VOICE_MAX_TURNS_PER_SESSION=20
VOICE_TEMP_AUDIO_RETENTION_MINUTES=30
VOICE_AUDIO_STORAGE_PATH=./runtime/audio
